//  Forward US sens 

void us_forward_init(void)
{US_FWD_TRIG_DDR  |=  US_FWD_TRIG_MASK;
 US_FWD_ECHO_DDR  &= ~US_FWD_ECHO_MASK;
US_FWD_TRIG_PORT &= ~US_FWD_TRIG_MASK;
}

uint16_t us_forward_read_cm(void)
{
    uint32_t t0; 
    t0 = get_tick_ms();
    while (US_FWD_ECHO_PIN & US_FWD_ECHO_MASK) {
        if (get_tick_ms() - t0 >= 10UL) return 0U;
    }
    // 10us trigger pulse
    US_FWD_TRIG_PORT &= ~US_FWD_TRIG_MASK;
 _delay_us(4);
    US_FWD_TRIG_PORT |=  US_FWD_TRIG_MASK;
  _delay_us(12);
    US_FWD_TRIG_PORT &= ~US_FWD_TRIG_MASK;
    // wait for echo to go high
    t0 = get_tick_ms();
    while (!(US_FWD_ECHO_PIN & US_FWD_ECHO_MASK)) {
 if (get_tick_ms() - t0 >= 38UL) return 0U;
    }
    // snapshot TCNT1 at echo rise using timer1 ticks gives us better esolution than ms we don't reset TCNT1 so servo PWM is not effected.
    uint8_t sreg;
    uint16_t t_start, t_end;
    sreg= SREG; cli(); t_start = TCNT1; SREG = sreg;
    
    t0 = get_tick_ms();
    while (US_FWD_ECHO_PIN & US_FWD_ECHO_MASK) {
        sreg = SREG; cli(); t_end = TCNT1; SREG = sreg;
        if ((uint16_t)(t_end - t_start) > 23200U) { _delay_ms(5); return 400U; }
        if (get_tick_ms() - t0 >= 38UL) return 0U;
    }

    sreg = SREG; cli(); t_end = TCNT1; SREG = sreg;
    uint16_t dist_cm = (t_end - t_start) / 116U;
    _delay_ms(60); 
    return dist_cm;
}
uint8_t us_forward_wall_detected(void)
{
    uint16_t d = us_forward_read_cm();
    return (d > 0U && d < US_FWD_TURN_THRESHOLD_CM) ? 1U : 0U;
}
uint8_t us_forward_get_turn_direction(uint16_t left_cm, uint16_t right_cm)
{
    return (left_cm > right_cm) ? 1U : 2U;
}

