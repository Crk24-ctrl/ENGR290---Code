static void timer0_init(void)
{// fast PWM on OC0A (thrust fan) COMPARE INTERUPT
    TCCR0A =(1 << COM0A1)| (1 << WGM01) | (1 << WGM00);
    TCCR0B = (1 << CS01)| (1 << CS00);   // prescaler= 64
    OCR0A= 0;
    TIMSK0 = (1 << OCIE0A);
}
static void delay_ms_nb(uint32_t ms)
{uint32_t s =sys_millis();
    while (sys_millis()- s < ms) {}}
uint8_t TWI_start(uint8_t twi_addr, uint8_t read_write)
{TWCR =(1 << TWINT) |(1 << TWSTA) |(1 << TWEN);
    while (!(TWCR & (1 << TWINT)));
    if (((TWSR & 0xF8)!= TW_START) &&((TWSR & 0xF8) != TW_REP_START)) return 1;

    twi_addr =(twi_addr<< 1)|(read_write &1);
TWDR= twi_addr;
TWCR =(1 << TWINT)| (1 << TWEN);
    while (!(TWCR & (1 <<TWINT)));
    if (((TWSR & 0xF8)!= TW_MT_SLA_ACK) && ((TWSR & 0xF8)!= TW_MR_SLA_ACK)) return 2;
    return 0;
}
void TWI_stop(void)
{ TWCR = (1 << TWINT) | (1 << TWEN) | (1 << TWSTO); while (TWCR & (1 << TWSTO));
}
uint8_t TWI_write(uint8_t tx_data)
{ TWDR = tx_data;  TWCR = (1 << TWINT) | (1 << TWEN);
    while (!(TWCR & (1 << TWINT)));  if ((TWSR & 0xF8) != TW_MT_DATA_ACK) return 1;
    return 0;}
uint8_t TWI_ack_read(void)
{ TWCR = (1 << TWINT) |(1 << TWEN) |(1 << TWEA);
    while (!(TWCR & (1 << TWINT)));
   flags.TWI_ACK = 1;
 if ((TWSR & 0xF8) != TW_MR_DATA_ACK) flags.TWI_ACK = 0;
    return TWDR;
}
uint8_t TWI_nack_read(void)
{ TWCR = (1 << TWINT) |(1 << TWEN);
    while (!(TWCR & (1 <<TWINT)));
    flags.TWI_ACK = 1;
if ((TWSR & 0xF8)!= TW_MR_DATA_NACK) return flags.TWI_ACK = 0;
    return TWDR;
}
uint8_t Read_Reg(uint8_t TWI_addr, uint8_t reg_addr)
{
 TWI_status = TWI_start(TWI_addr, TW_WRITE); if (TWI_status) return 1;
    TWI_status = TWI_write(reg_addr);            if (TWI_status) return 2;
  TWI_status = TWI_start(TWI_addr, TW_READ);  if (TWI_status) return 3;
    TWI_byte= TWI_nack_read();
 TWI_stop();
    if (!flags.TWI_ACK) return 4;
    return 0;
}

uint8_t Read_Reg_N(uint8_t TWI_addr, uint8_t reg_addr, uint8_t bytes, int16_t *data)
    {uint8_t *p = (uint8_t *)data;
TWI_status = TWI_start(TWI_addr, TW_WRITE); if (TWI_status) return 1;
    TWI_status = TWI_write(reg_addr);if (TWI_status) return 2;
    TWI_status = TWI_start(TWI_addr, TW_READ);  if (TWI_status) return 3;
    for (uint8_t i = 0; i < bytes - 1; i++) {
        *p = TWI_ack_read();
        if (!flags.TWI_ACK) return 5; 
        p++;
    }
    *p = TWI_nack_read();
    TWI_stop();
    if (!flags.TWI_ACK) return 4;
    return 0;
}
uint8_t Write_Reg(uint8_t TWI_addr, uint8_t reg_addr, uint8_t value)
{TWI_status = TWI_start(TWI_addr, TW_WRITE); if (TWI_status) return 1;
    TWI_status= TWI_write(reg_addr);if (TWI_status) return 2;
    TWI_status =TWI_write(value);if (TWI_status) return 3;
    TWI_stop();
    if (!flags.TWI_ACK) return 4;
    return 0;
}

//  IMU IMPL //not sure
static int16_t gz_bias= 0;
static int32_t yaw_cdeg  = 0;
static uint8_t tilt_flag = 0u;
 // MPU stores big indian 
static int16_t read_word(uint8_t reg)
{   Read_Reg(MPU_ADDR, reg);
    uint8_t h = TWI_byte;
    Read_Reg(MPU_ADDR,(uint8_t)(reg +1u));
    uint8_t l = TWI_byte;
    return (int16_t)(((uint16_t)h << 8) |(uint16_t)l);}
void imu_init(void)
{TWSR = 0x00u;
    TWBR = 72u;
    _delay_ms(150);// MPU needs time after power-on before it responds
  Write_Reg(MPU_ADDR, REG_PWR_MGMT1,0x00u);// wake
    _delay_ms(10);
    Write_Reg(MPU_ADDR, REG_GYRO_CONFIG,0x00u);//+-250 deg/s
 Write_Reg(MPU_ADDR, REG_ACCEL_CONFIG, 0x00u);//+-2g
    _delay_ms(10);}
void imu_calibrate(void)
{ int32_t sum =0;
    for (uint8_t i =0u; i <CALIB_SAMPLES; i++) {
   sum += (int32_t)read_word(REG_GYRO_ZOUT_H);
        _delay_ms(5);
    }
    gz_bias= (int16_t)(sum /(int32_t)CALIB_SAMPLES);
    yaw_cdeg= 0;
    tilt_flag= 0u;}
void imu_update(uint16_t dt_ms)
{if (dt_ms == 0u) return;
    int16_t gz_raw =read_word(REG_GYRO_ZOUT_H);
  int32_t gz=(int32_t)((int16_t)(gz_raw - gz_bias))*(int32_t)GYRO_SIGN;
    yaw_cdeg+= (gz*(int32_t)dt_ms) /(int32_t)GYRO_DIV;
  // use accel X and Y magnitude to catch if the craft tips overr
    int16_t ax =read_word(REG_ACCEL_XOUT_H);
 int16_t ay =read_word((uint8_t)(REG_ACCEL_XOUT_H + 2u));
    if (ax< 0) ax= (int16_t)(-ax);
  if (ay < 0) ay= (int16_t)(-ay);
    tilt_flag = ((ax > (int16_t)TILT_THRESHOLD_LSB) ||   (ay > (int16_t)TILT_THRESHOLD_LSB)) ?1u : 0u;
}
int32_t imu_get_yaw_cdeg(void) { return yaw_cdeg; }
void imu_reset_yaw(void){ yaw_cdeg = 0; }
uint8_t imu_tilt_detected(void){ return tilt_flag; }

