static void uart_init(void)
{
  UBRR0H =(uint8_t)(MYUBRR >> 8);
 UBRR0L= (uint8_t)(MYUBRR);
 UCSR0B =(1 << TXEN0);
 UCSR0C =(1 << UCSZ01) |(1 << UCSZ00);  
}
static void uart_tx(uint8_t c)    { while (!(UCSR0A & (1 << UDRE0))) {} UDR0 = c; }
static void uart_str(const char *s) { while (*s) uart_tx((uint8_t)*s++); }
static void uart_u16(uint16_t n){ char b[6];  utoa(n, b, 10);  uart_str(b); }
static void uart_i32(int32_t  n)
{if (n <0) { uart_tx('-'); n = -n; }
    char b[12]; ltoa(n, b, 10); uart_str(b);
}
static int16_t clamp16f(float v, float lo, float hi)
{if (v <lo) v = lo;
if (v > hi) v = hi;
 return (int16_t)v;
}
static void pid_reset(float *integral, float *prev_err)
{ *integral = 0.0f; *prev_err = 0.0f;
}
static uint8_t thrust_from_distance(uint16_t fwd_cm)
{ if (fwd_cm == 0U ||fwd_cm >= THRUST_FULL_CM) return THRUST_FULL_PCT;
    if (fwd_cm <= WALL_THRESHOLD_CM)return THRUST_MIN_PCT;
    uint16_t span= THRUST_FULL_CM - WALL_THRESHOLD_CM;
   uint16_t dist_in= fwd_cm - WALL_THRESHOLD_CM;
    uint8_t  pct_span = THRUST_FULL_PCT - THRUST_MIN_PCT;
    return (uint8_t)(THRUST_MIN_PCT + (uint16_t)(dist_in * pct_span) /span);
}

//  Main 
static void hovercraft_main(void)
{
 timer0_init();
 uart_init();
lift_fan_init();
    servo_init();
 thrust_fan_init();
    us_forward_init();
    us_left_init();
 imu_init();
    sei();
    lift_fan_on();
    uart_str("  ENGR290  #11 Competition WOOHOOOOOOOOOO  \r\n");
    servo_home();
    g_state = STATE_HOVER_UP;
    uint32_t state_entry_ms = sys_millis();
    uint32_t prev_ms= state_entry_ms;

    float yaw_integral = 0.0f;
    float yaw_prev_err = 0.0f;
    uart_str("[INIT ] Lift fan ON waiting for air cushion\r\n");

    while (1)//always trye
    {  lift_fan_on();  // t makes sure lift never drops mid-run
        uint32_t now= sys_millis();
        uint16_t dt_ms = (uint16_t)(now -prev_ms);
        prev_ms= now;
        switch (g_state)
        {
            case STATE_HOVER_UP:
                // wait for the air to build upthen calibrate
                if (now - state_entry_ms >= HOVER_SPINUP_MS) {
                    uart_str("[INIT ]  Calibrating gyro hold still...\r\n");
                    imu_calibrate();
                   imu_reset_yaw();
                 pid_reset(&yaw_integral, &yaw_prev_err);
                   servo_home();
                thrust_fan_on();
                    g_state= STATE_DRIVE;
                    state_entry_ms = sys_millis();
                  prev_ms= state_entry_ms;
                  uart_str("[STATE]  DRIVE  thrust ON\r\n");
                }
                break;
            case STATE_DRIVE:
            {
                imu_update(dt_ms);
                uint16_t fwd = us_forward_read_cm();
               uint16_t lt= us_left_read_cm();
               int32_t  yaw =imu_get_yaw_cdeg();
                float err  =(float)yaw /100.0f;
                float dt_s =(float)dt_ms /1000.0f;
             yaw_integral += err *dt_s;
                if (yaw_integral> YAW_INTEGRAL_CAP) yaw_integral =YAW_INTEGRAL_CAP;
                if (yaw_integral < -YAW_INTEGRAL_CAP) yaw_integral= -YAW_INTEGRAL_CAP;
                float deriv = (dt_ms > 0u) ? (err - yaw_prev_err) /dt_s : 0.0f;
                float pid_out = YAW_KP * err + YAW_KI * yaw_integral +YAW_KD * deriv;
                yaw_prev_err = err;
                int16_t corr = clamp16f(pid_out,             -(float)YAW_MAX_CORR,
                                  (float)YAW_MAX_CORR);
                servo_set((uint16_t)((int16_t)SERVO_HOME + corr));
                if (imu_tilt_detected())
                    uart_str("[WARN ]  TILT detected craft not level!\r\n");
                uint8_t tpct = thrust_from_distance(fwd); 
                thrust_fan_set_speed(tpct);
              uart_str("[DRIVE]  FWD:"); 
                uart_u16(fwd); uart_str("cm");
              uart_str(fwd <= WALL_THRESHOLD_CM ? "[WALL]" : "      ");
                uart_str("  LT:");
                uart_u16(lt);  uart_str("cm");
            uart_str(lt > US_LEFT_OPEN_CM ? "[OPEN]": "[WALL]");
                uart_str("  YAW:");
               uart_i32(yaw); uart_str("cd");
                uart_str("  CORR:");
                uart_i32((int32_t)corr);
                uart_str("  THR:");
                uart_u16(tpct); uart_str("%\r\n");
                // wall ahead se left sensor to pick which way to turn
                if (fwd> 0U && fwd <= WALL_THRESHOLD_CM) {
                    imu_reset_yaw();
                    pid_reset(&yaw_integral, &yaw_prev_err);
                    if (lt > US_LEFT_OPEN_CM) {
                      g_state = STATE_TURN_LEFT;
                        uart_str("[STATE]  TURN_LEFT\r\n");
                    } else {g_state = STATE_TURN_RIGHT;
                        uart_str("[STATE]  TURN_RIGHT\r\n");
                    }
                    state_entry_ms = sys_millis();
                    prev_ms= state_entry_ms;
                }
                break;
            }
            case STATE_TURN_LEFT:
            {
        imu_update(dt_ms);
              servo_set(SERVO_LEFT);
                thrust_fan_on();
                int32_t  yaw= imu_get_yaw_cdeg();
              uint32_t elapsed = now - state_entry_ms;
              uart_str("[TURN ]  LEFT  yaw:");
                uart_i32(yaw);
              uart_str("cd  t:");
                uart_u16((uint16_t)elapsed);
               uart_str("ms\r\n");
                uint8_t imu_done = (yaw  >= (int32_t)(TURN_TARGET_CDEG -TURN_DONE_TOL_CDEG));
                uint8_t time_done = (elapsed >= TURN_TIMEOUT_MS);
                if (imu_done ||time_done) {
                    if (time_done && !imu_done)
                        uart_str("[WARN ]  Turn timed out (IMU  failed)\r\n");
                    thrust_fan_off();
                    delay_ms_nb(150);  //short pause to let craft settle before driving 
                    servo_home();
                  imu_reset_yaw();
                    pid_reset(&yaw_integral, &yaw_prev_err);
                    thrust_fan_on();
                    g_state= STATE_DRIVE;
                    state_entry_ms = sys_millis();
                    prev_ms= state_entry_ms;
                    uart_str("[STATE]  DRIVE\r\n");
                }
                break;}
            case STATE_TURN_RIGHT:
            {imu_update(dt_ms);
                servo_set(SERVO_RIGHT);
                thrust_fan_on();
                int32_t  yaw= imu_get_yaw_cdeg();
                uint32_t elapsed =now -state_entry_ms;
                uart_str("[TURN ]  RIGHT yaw:");
                uart_i32(yaw);
                uart_str("cd  t:");
                uart_u16((uint16_t)elapsed);
                uart_str("ms\r\n");

                uint8_t imu_done = (yaw <=-(int32_t)(TURN_TARGET_CDEG- TURN_DONE_TOL_CDEG));
                uint8_t time_done = (elapsed >= TURN_TIMEOUT_MS);
                if (imu_done||time_done) {
                    if (time_done && !imu_done)
          uart_str("[WARN ]  Turn timed out (IMU may have failed)\r\n");
                    thrust_fan_off();
                   delay_ms_nb(150);
                servo_home();
                   imu_reset_yaw();
                   pid_reset(&yaw_integral, &yaw_prev_err);
                   thrust_fan_on();
                  g_state= STATE_DRIVE;
                    state_entry_ms = sys_millis();
                    prev_ms= state_entry_ms;
                uart_str("[STATE]  DRIVE\r\n");
                }
                break;
            }
        }
    }
}

